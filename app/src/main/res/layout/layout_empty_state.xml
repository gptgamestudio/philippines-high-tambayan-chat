<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/empty_state_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_background"
    android:padding="24dp">

    <!-- Card Container for Cute Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_card_white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Cute Cloud Placeholder Graphic / Loading Indicator -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <!-- Cloud Graphic -->
            <ImageView
                android:id="@+id/iv_empty_graphic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Sleeping Cloud"
                android:src="@drawable/ic_cloud_cute" />

            <!-- Indeterminate Circular Loading Progress (shown when loading) -->
            <ProgressBar
                android:id="@+id/pb_loading_spinner"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/empty_offline_title"
            android:textColor="@color/kid_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_offline_subtitle"
            android:textColor="#546E7A"
            android:textSize="15sp" />

        <!-- Tactile Retry Button -->
        <Button
            android:id="@+id/btn_retry_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_tactile_button"
            android:paddingStart="32dp"
            android:paddingTop="12dp"
            android:paddingEnd="32dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_retry"
            android:textAllCaps="false"
            android:textColor="@color/kid_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
